---
import type { CollectionEntry } from "astro:content";
import EventCountdown from "./EventCountdown.astro";
import { eventStartIso, isUpcoming } from "../lib/events";

interface Props {
  event: CollectionEntry<"etkinlikler">;
  imageClass?: string;
  heading?: "h2" | "h3";
  revealDelay?: number;
  featured?: boolean;
  slide?: boolean;
  countdown?: boolean;
}

const {
  event,
  imageClass = "h-52",
  heading: Heading = "h3",
  revealDelay,
  featured = false,
  slide = false,
  countdown = false,
} = Astro.props;
const upcoming = isUpcoming(event.data.date);
---

<a
  href={`/etkinlikler/${event.id}`}
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-3xl bg-cream shadow-[4px_6px_18px_rgb(27_39_32_/_0.12)]",
    featured && "md:flex-row md:items-stretch",
    slide && "event-slide-card",
  ]}
  data-reveal={typeof revealDelay === "number" ? "" : undefined}
  style={typeof revealDelay === "number" ? `--reveal-delay: ${revealDelay}ms` : undefined}
>
  <div
    class:list={[
      "relative z-10 overflow-visible",
      featured
        ? "h-52 w-full shrink-0 md:h-72 md:min-h-72 md:w-1/2 md:self-stretch"
        : "shrink-0",
    ]}
  >
    <img
      src={event.data.image}
      alt=""
      class:list={[
        "object-cover",
        featured ? "h-full w-full" : ["w-full shrink-0", imageClass],
      ]}
    />
    {countdown && <EventCountdown iso={eventStartIso(event.data.date)} />}
    <p
      class:list={[
        "pointer-events-none absolute top-3 right-3 z-10 rounded-full px-3 py-1 text-xs",
        upcoming ? "bg-fuchsia text-paper" : "bg-paper/90 text-ink/55",
      ]}
    >
      {upcoming ? "Gelecek" : "Geçmiş"}
    </p>
  </div>
  <div
    class:list={[
      "flex flex-1 flex-col",
      featured ? "p-5 md:p-8" : "p-5",
    ]}
  >
    <p class="text-xs tracking-wide text-moss uppercase">
      {event.data.date.toLocaleDateString("tr-TR")}
    </p>
    <Heading
      class:list={[
        "mt-2 font-display group-hover:text-fuchsia",
        featured
          ? "line-clamp-2 text-2xl md:line-clamp-none md:text-3xl md:text-4xl"
          : "line-clamp-2 text-2xl",
      ]}
    >
      {event.data.title}
    </Heading>
    <p
      class:list={[
        "mt-2 text-ink/65",
        featured ? "line-clamp-2 text-sm md:line-clamp-none md:text-base" : "line-clamp-2 text-sm",
      ]}
    >
      {event.data.description}
    </p>
    <p class="mt-auto inline-flex shrink-0 items-center gap-1 pt-4 text-sm font-medium text-fuchsia">
      Etkinliği gör
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        fill="none"
        class="h-4 w-4 shrink-0 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:group-hover:translate-x-[0.3rem]"
        aria-hidden="true"
      >
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </p>
  </div>
</a>
