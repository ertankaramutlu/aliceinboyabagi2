---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
  {
    eyebrow && (
      <p class="mb-3 text-xs font-semibold tracking-[0.22em] text-fuchsia uppercase">
        {eyebrow}
      </p>
    )
  }
  <h2 class="font-display text-4xl tracking-tight text-ink md:text-5xl">{title}</h2>
  {
    intro && (
      <p class="mt-4 text-base leading-relaxed text-ink/70 md:text-lg">{intro}</p>
    )
  }
</div>
