---
import { site } from "../data/site";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const year = new Date().getFullYear();
const legal = [
  { href: "/kvkk", label: "KVKK" },
  { href: "/gizlilik", label: "Gizlilik" },
  { href: "/cerez", label: "Çerez" },
] as const;
---

<footer class="bg-ink text-cream" {...(home ? { "data-reveal": "" } : {})}>
  <div class="mx-auto grid max-w-6xl grid-cols-2 items-center gap-8 px-4 py-8 md:px-6">
    <div>
      <a href="/#anasayfa" class="inline-block shrink-0">
        <img src="/logo.png" alt={site.name} class="h-14 w-auto brightness-110 md:h-16" />
      </a>
      <p class="mt-3 text-sm text-cream/45">{site.locationLabel}.</p>
    </div>

    <nav class="flex w-full flex-col items-end justify-end gap-2 text-sm md:flex-row md:items-center md:justify-end md:gap-x-6" aria-label="Yasal">
      {
        legal.map((item) => (
          <a class="text-cream/75 transition hover:text-lime" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="flex flex-col items-center gap-1 border-t border-cream/10 px-4 py-4 text-center text-xs text-cream/45 md:flex-row md:justify-center md:gap-0">
    <span>© {year} Alice in Boyabağı Camping. Tüm hakları saklıdır.</span>
    <span class="hidden md:inline">&nbsp;·&nbsp;</span>
    <span>Tasarım: Ertan KARAMUTLU</span>
  </div>
</footer>
