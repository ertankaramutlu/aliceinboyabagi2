---
import { site, whatsappUrl } from "../../data/site";
import SectionHeading from "../SectionHeading.astro";
---

<section id="iletisim" class="section-pad">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading
      eyebrow="İletişim"
      title="Yolu sor, yeri söyleyelim"
    />
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl bg-paper p-8" data-reveal>
        <p class="font-display text-2xl">Adres</p>
        <p class="mt-2 text-ink/70">{site.address}</p>
        <p class="mt-6 font-display text-2xl">Saatler</p>
        <p class="mt-2 text-ink/70">{site.hours}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={whatsappUrl()}
            class="rounded-full bg-fuchsia px-5 py-3 text-sm font-medium text-paper"
            target="_blank"
            rel="noreferrer">WhatsApp</a
          >
          <a
            href={site.mapsUrl}
            class="rounded-full border border-ink/15 px-5 py-3 text-sm"
            target="_blank"
            rel="noreferrer">Harita</a
          >
          <a
            href={site.instagram}
            class="rounded-full border border-ink/15 px-5 py-3 text-sm"
            target="_blank"
            rel="noreferrer">Instagram</a
          >
        </div>
      </div>
      <div
        class="flex min-h-72 flex-col overflow-hidden rounded-3xl md:min-h-full"
        data-reveal
        style="--reveal-delay: 60ms"
      >
        <iframe
          title="Boyabağı Koyu haritası"
          aria-label="Boyabağı Koyu haritası"
          src="https://maps.google.com/maps?q=Boyaba%C4%9F%C4%B1%20Koyu%20Karaburun&output=embed"
          class="min-h-72 w-full flex-1 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a
          href={site.mapsUrl}
          target="_blank"
          rel="noreferrer"
          class="bg-cream px-4 py-3 text-center text-sm font-medium"
        >
          Haritada aç
        </a>
      </div>
    </div>
  </div>
</section>
