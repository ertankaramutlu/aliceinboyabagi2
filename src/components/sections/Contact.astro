---
import { site, whatsappUrl } from "../../data/site";
import SectionHeading from "../SectionHeading.astro";
---

<section id="iletisim" class="section-pad">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading
      eyebrow="İletişim"
      title="Yolu sor, yeri söyleyelim"
    />
    <div class="grid gap-6 md:grid-cols-2">
      <div
        class="flex h-full flex-col rounded-3xl bg-cream p-6 shadow-[3px_4px_14px_rgb(27_39_32_/_0.07)] md:p-8"
        data-reveal
      >
        <p class="text-xs font-semibold tracking-[0.18em] text-ink/50 uppercase">Adres</p>
        <a
          href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.address)}`}
          class="mt-2 font-display text-lg hover:text-fuchsia hover:underline"
          target="_blank"
          rel="noreferrer"
        >
          {site.address}
        </a>
        <div class="mt-8 flex flex-col gap-3 md:mt-auto md:pt-8">
          <a
            href={whatsappUrl()}
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-fuchsia text-sm font-medium text-paper transition hover:bg-fuchsia-deep"
            target="_blank"
            rel="noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0" aria-hidden="true">
              <path d="M8 2.5a5.5 5.5 0 0 0-4.7 8.3L2.5 13.5l2.8-.7A5.5 5.5 0 1 0 8 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
            </svg>
            WhatsApp ile yaz
          </a>
          <a
            href={`tel:+${site.whatsapp.number}`}
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-ink/15 text-sm transition hover:border-fuchsia hover:text-fuchsia"
            aria-label="Telefonla ara"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0" aria-hidden="true">
              <path d="M4.2 2.8h2l.8 2.2-1.2.9a7 7 0 0 0 3.3 3.3l.9-1.2 2.2.8v2A1.2 1.2 0 0 1 11 12 8.2 8.2 0 0 1 4 5a1.2 1.2 0 0 1 .2-2.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href={site.instagram}
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-ink/15 text-sm transition hover:border-fuchsia hover:text-fuchsia"
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0" aria-hidden="true">
              <rect x="2.5" y="2.5" width="11" height="11" rx="3" stroke="currentColor" stroke-width="1.4"></rect>
              <circle cx="8" cy="8" r="2.4" stroke="currentColor" stroke-width="1.4"></circle>
              <circle cx="11.3" cy="4.7" r="0.6" fill="currentColor"></circle>
            </svg>
          </a>
        </div>
      </div>
      <div
        class="flex min-h-72 flex-col overflow-hidden rounded-3xl md:min-h-full"
        data-reveal
        style="--reveal-delay: 60ms"
      >
        <iframe
          title="Boyabağı Koyu haritası"
          aria-label="Boyabağı Koyu haritası"
          src={`${site.mapsUrl}&output=embed`}
          class="h-full min-h-72 w-full flex-1 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
