---
import { gallery } from "../../data/site";
import SectionHeading from "../SectionHeading.astro";
---

<section id="galeri" class="section-pad">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading
      eyebrow="Galeri"
      title="Yerin kendisi konuşsun"
      intro="Çadır, çam, koy, taş duvar. Fotoğraflar işletmeden."
    />
  </div>

  <div class="gallery-band" data-reveal>
    <div id="gallery-strip" class="gallery-strip">
      <div class="gallery-track">
        {
          gallery.map((item, i) => (
            <a
              href={item.src}
              data-gallery
              data-index={i}
              class="gallery-card group relative block overflow-hidden rounded-3xl bg-sand"
            >
              <img
                src={item.src}
                alt={item.alt}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
    </div>
    <div class="mt-3 flex justify-center gap-2">
      <button
        type="button"
        data-gallery-prev
        hidden
        aria-hidden="true"
        class="gallery-arrow inline-flex h-12 w-12 items-center justify-center rounded-full border border-ink/15 bg-paper/80 text-ink transition hover:border-fuchsia hover:text-fuchsia"
        aria-label="Önceki fotoğraflar"
      >
        ←
      </button>
      <button
        type="button"
        data-gallery-next
        class="gallery-arrow inline-flex h-12 w-12 items-center justify-center rounded-full border border-ink/15 bg-paper/80 text-ink transition hover:border-fuchsia hover:text-fuchsia"
        aria-label="Sonraki fotoğraflar"
      >
        →
      </button>
    </div>
  </div>
</section>

<dialog
  id="lightbox"
  class="fixed inset-0 z-[60] m-0 h-dvh max-h-none w-full max-w-none border-0 bg-ink/85 p-4 backdrop:bg-transparent"
>
  <div class="flex min-h-full items-center justify-center" data-lb-dismiss>
    <div class="relative w-[min(96vw,1100px)]">
      <img id="lightbox-img" alt="" class="max-h-[82vh] w-full rounded-xl object-contain" />
      <p id="lightbox-cap" class="mt-3 text-center text-sm text-cream/80"></p>
      <button
        type="button"
        data-lb="prev"
        class="lb-arrow absolute top-1/2 left-2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-ink/15 bg-cream/80 text-ink transition hover:border-fuchsia hover:bg-cream/90 hover:text-fuchsia"
        aria-label="Önceki"
      >
        ←
      </button>
      <button
        type="button"
        data-lb="next"
        class="lb-arrow absolute top-1/2 right-2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-ink/15 bg-cream/80 text-ink transition hover:border-fuchsia hover:bg-cream/90 hover:text-fuchsia"
        aria-label="Sonraki"
      >
        →
      </button>
      <button
        type="button"
        data-lb="close"
        class="absolute top-3 right-3 rounded-full border border-ink/15 bg-cream/80 px-3 py-1.5 text-sm text-ink transition hover:border-fuchsia hover:bg-cream/90 hover:text-fuchsia"
      >
        Kapat
      </button>
    </div>
  </div>
</dialog>

<script>
  const strip = document.getElementById("gallery-strip");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-gallery-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-gallery-next]");
  const items = [...document.querySelectorAll<HTMLAnchorElement>("#galeri a[data-gallery]")];
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const cap = document.getElementById("lightbox-cap");
  let index = 0;

  const cardStep = () => {
    const card = strip?.querySelector<HTMLElement>(".gallery-card");
    if (!card || !strip) return 320;
    const styles = getComputedStyle(strip.querySelector(".gallery-track") as HTMLElement);
    const gap = Number.parseFloat(styles.columnGap || styles.gap) || 12;
    return card.getBoundingClientRect().width + gap;
  };

  const maxScroll = () => Math.max(0, (strip?.scrollWidth ?? 0) - (strip?.clientWidth ?? 0));

  const scrollByCard = (dir: number) => {
    if (!strip) return;
    const next = Math.min(maxScroll(), Math.max(0, strip.scrollLeft + dir * cardStep()));
    strip.scrollTo({ left: next, behavior: "smooth" });
  };

  const setArrow = (btn: HTMLButtonElement | null, hide: boolean) => {
    if (!btn) return;
    btn.toggleAttribute("hidden", hide);
    btn.setAttribute("aria-hidden", String(hide));
    btn.tabIndex = hide ? -1 : 0;
  };

  const updateArrows = () => {
    if (!strip) return;
    const max = maxScroll();
    if (strip.scrollLeft > max) strip.scrollLeft = max;
    const sl = strip.scrollLeft;
    setArrow(prevBtn, sl <= 2);
    setArrow(nextBtn, sl >= max - 2);
  };

  prevBtn?.addEventListener("click", () => scrollByCard(-1));
  nextBtn?.addEventListener("click", () => scrollByCard(1));
  strip?.addEventListener("scroll", updateArrows, { passive: true });
  strip?.addEventListener("scrollend", updateArrows);
  updateArrows();

  const lbPrev = dialog?.querySelector<HTMLButtonElement>('[data-lb="prev"]');
  const lbNext = dialog?.querySelector<HTMLButtonElement>('[data-lb="next"]');
  const lastIndex = () => Math.max(0, items.length - 1);

  const show = (i: number) => {
    index = Math.min(lastIndex(), Math.max(0, i));
    const node = items[index];
    if (!node) return;
    if (img) {
      img.src = node.href;
      img.alt = node.querySelector("img")?.alt ?? "";
    }
    if (cap) cap.textContent = img?.alt ?? "";
    setArrow(lbPrev ?? null, index <= 0);
    setArrow(lbNext ?? null, index >= lastIndex());
    if (dialog && !dialog.open) dialog.showModal();
  };

  items.forEach((node, i) => {
    node.addEventListener("click", (e) => {
      e.preventDefault();
      show(i);
    });
  });

  lbPrev?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (index > 0) show(index - 1);
  });
  lbNext?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (index < lastIndex()) show(index + 1);
  });
  dialog?.querySelector('[data-lb="close"]')?.addEventListener("click", (e) => {
    e.stopPropagation();
    dialog.close();
  });
  const dismissUnlessControl = (e: Event) => {
    const el = e.target;
    if (!(el instanceof Element)) return;
    if (el.closest("[data-lb='prev'], [data-lb='next'], [data-lb='close']")) return;
    dialog.close();
  };
  dialog?.addEventListener("click", dismissUnlessControl, true);
  window.addEventListener("keydown", (e) => {
    if (!dialog?.open) return;
    if (e.key === "Escape") dialog.close();
    if (e.key === "ArrowRight" && index < lastIndex()) show(index + 1);
    if (e.key === "ArrowLeft" && index > 0) show(index - 1);
  });
</script>

<style>
  .gallery-band {
    position: relative;
    width: 100%;
    max-width: 100%;
    container-type: inline-size;
  }

  .gallery-band > * {
    --gallery-pl: max(1rem, calc((100cqw - 72rem) / 2 + 1rem));
  }

  @media (min-width: 768px) {
    .gallery-band > * {
      --gallery-pl: max(1.5rem, calc((100cqw - 72rem) / 2 + 1.5rem));
    }
  }

  .gallery-arrow[hidden],
  .lb-arrow[hidden] {
    display: none !important;
  }

  .gallery-strip {
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gallery-strip::-webkit-scrollbar {
    display: none;
  }

  .gallery-track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    padding-left: var(--gallery-pl);
    padding-right: var(--gallery-pl);
  }

  .gallery-card {
    box-sizing: border-box;
    flex: 0 0 calc((100cqw - var(--gallery-pl) - 1rem - 0.75rem) / 1.28);
    width: calc((100cqw - var(--gallery-pl) - 1rem - 0.75rem) / 1.28);
    height: 16.5rem;
  }

  @media (min-width: 1024px) {
    .gallery-card {
      flex: 0 0 calc((100cqw - var(--gallery-pl) - 1.5rem - 2.25rem) / 3.5);
      width: calc((100cqw - var(--gallery-pl) - 1.5rem - 2.25rem) / 3.5);
      height: 22rem;
    }
  }
</style>
