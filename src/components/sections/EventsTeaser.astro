---
import type { CollectionEntry } from "astro:content";
import EventCard from "../EventCard.astro";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  events: CollectionEntry<"etkinlikler">[];
}

const { events } = Astro.props;
---

<section id="etkinlik" class="section-pad">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading
      eyebrow="Etkinlik"
      title="Bu sezon neler var"
      intro="Konser, açık hava, küçük buluşmalar. Kartlara tıklayınca detay sayfası açılır."
    />
    <div class="grid gap-6 md:grid-cols-2">
      {
        events.map((event, i) => (
          <EventCard event={event} heading="h3" imageClass="h-52" revealDelay={i * 60} />
        ))
      }
    </div>
    <p class="mt-8 text-center" data-reveal>
      <a href="/etkinlikler" class="text-base font-medium text-fuchsia hover:underline">
        Tüm etkinlikler
      </a>
    </p>
  </div>
</section>
