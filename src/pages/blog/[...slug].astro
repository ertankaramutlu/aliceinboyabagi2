---
import Base from "../../layouts/Base.astro";
import { getBlogPosts } from "../../lib/blog";
import { marked } from "marked";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const html = marked.parse(post.body, { async: false }) as string;
---

<Base title={post.title} description={post.description} image={post.image}>
  <article class="section-pad mx-auto max-w-3xl px-4 pt-28 md:px-6">
    <p class="text-xs tracking-wide text-moss uppercase">
      {post.pubDate.toLocaleDateString("tr-TR")}
    </p>
    <h1 class="mt-3 font-display text-4xl md:text-5xl">{post.title}</h1>
    <img
      src={post.image}
      alt=""
      class="mt-8 h-72 w-full rounded-3xl object-cover shadow-[4px_6px_18px_rgb(27_39_32_/_0.12)]"
    />
    <div class="prose-alice mt-8 space-y-4 text-lg" set:html={html} />
    <p class="mt-12">
      <a
        href="/blog"
        class="group inline-flex items-center gap-1 text-sm font-medium text-fuchsia"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="none"
          class="h-4 w-4 shrink-0 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:group-hover:-translate-x-[0.3rem]"
          aria-hidden="true"
        >
          <path
            d="M13 8H3M7 4l-4 4 4 4"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Tüm yazılar
      </a>
    </p>
  </article>
</Base>
