---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const events = (await getCollection("etkinlikler")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
---

<Base title="Etkinlikler" description="Alice in Boyabağı etkinlikleri.">
  <div class="section-pad mx-auto max-w-6xl px-4 pt-28 md:px-6">
    <p class="text-xs font-semibold tracking-[0.22em] text-fuchsia uppercase">Etkinlik</p>
    <h1 class="mt-3 font-display text-5xl">Takvim</h1>
    <div class="mt-12 space-y-6">
      {
        events.map((event) => (
          <a
            href={`/etkinlikler/${event.id}`}
            class="flex flex-col overflow-hidden rounded-3xl bg-paper md:flex-row"
          >
            <img src={event.data.image} alt="" class="h-48 w-full object-cover md:w-72" />
            <div class="p-6">
              <p class="text-xs font-semibold text-fuchsia uppercase">
                {event.data.date.toLocaleDateString("tr-TR", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </p>
              <h2 class="mt-2 font-display text-3xl">{event.data.title}</h2>
              <p class="mt-2 text-ink/70">{event.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
