---
import Base from "../../layouts/Base.astro";
import EventCountdown from "../../components/EventCountdown.astro";
import { whatsappUrl } from "../../data/site";
import { eventStartIso, firstUpcoming } from "../../lib/events";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("etkinlikler");
  const countdownId = firstUpcoming(events)?.id;
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event, countdown: event.id === countdownId },
  }));
}

const { event, countdown } = Astro.props;
const { Content } = await render(event);
---

<Base title={event.data.title} description={event.data.description} image={event.data.image}>
  <article class="section-pad mx-auto max-w-3xl px-4 pt-28 md:px-6">
    <p class="text-xs font-semibold tracking-wide text-fuchsia uppercase">
      {event.data.date.toLocaleDateString("tr-TR", {
        day: "numeric",
        month: "long",
        year: "numeric",
      })}
      {event.data.placeholder && " · örnek etkinlik"}
    </p>
    <h1 class="mt-3 font-display text-4xl md:text-5xl">{event.data.title}</h1>
    <div class="relative mt-8">
      <img
        src={event.data.image}
        alt=""
        class="h-72 w-full rounded-3xl object-cover shadow-[4px_6px_18px_rgb(27_39_32_/_0.12)]"
      />
      {countdown && <EventCountdown iso={eventStartIso(event.data.date)} />}
    </div>
    <div class="prose-alice mt-8 space-y-4 text-lg">
      <Content />
    </div>
    <a
      href={whatsappUrl(`Merhaba, ${event.data.title} etkinliği için bilgi almak istiyorum.`)}
      class="mt-10 inline-flex rounded-full bg-fuchsia px-6 py-3 text-sm font-medium text-paper"
      target="_blank"
      rel="noreferrer"
    >
      WhatsApp’tan sor
    </a>
    <p class="mt-8">
      <a
        href="/etkinlikler"
        class="group inline-flex items-center gap-1 text-sm font-medium text-fuchsia"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="none"
          class="h-4 w-4 shrink-0 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:group-hover:-translate-x-[0.3rem]"
          aria-hidden="true"
        >
          <path
            d="M13 8H3M7 4l-4 4 4 4"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Tüm etkinlikler
      </a>
    </p>
  </article>
</Base>
