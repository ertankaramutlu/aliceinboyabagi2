---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Stay from "../components/sections/Stay.astro";
import Gallery from "../components/sections/Gallery.astro";
import BlogTeaser from "../components/sections/BlogTeaser.astro";
import EventsTeaser from "../components/sections/EventsTeaser.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";
import { getCollection } from "astro:content";
import { getBlogPosts } from "../lib/blog";
import { firstUpcoming, sortEvents } from "../lib/events";

const posts = (await getBlogPosts()).slice(0, 3);

const allEvents = sortEvents(await getCollection("etkinlikler"));
const countdownId = firstUpcoming(allEvents)?.id;
const events = allEvents.slice(0, 2);
---

<Base>
  <Hero />
  <About />
  <Stay />
  <Gallery />
  <BlogTeaser posts={posts} />
  <EventsTeaser events={events} countdownId={countdownId} />
  <Faq />
  <Contact />
</Base>
